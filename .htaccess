# ============================================================
#  Paul Lamouret — Portfolio
#  Configuration Apache (.htaccess)
# ============================================================

# ===== PAGE 404 PERSONNALISÉE =====
ErrorDocument 404 /404.html

# ===== COMPRESSION GZIP =====
# Réduit le poids des fichiers texte transférés
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ===== MISE EN CACHE DES ASSETS =====
<IfModule mod_expires.c>
  ExpiresActive On

  # Images → 1 semaine (permet de mettre à jour sans attente)
  ExpiresByType image/png             "access plus 1 week"
  ExpiresByType image/jpg             "access plus 1 week"
  ExpiresByType image/jpeg            "access plus 1 week"
  ExpiresByType image/webp            "access plus 1 week"
  ExpiresByType image/gif             "access plus 1 week"
  ExpiresByType image/svg+xml         "access plus 1 week"
  ExpiresByType image/x-icon          "access plus 1 year"

  # Fonts → 1 an (ne changent jamais)
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"

  # CSS & JS → sans cache (géré par cache busting via ?v=X dans le HTML)
  ExpiresByType text/css              "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"

  # HTML → pas de cache (toujours frais)
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ===== EN-TÊTES DE SÉCURITÉ =====
<IfModule mod_headers.c>
  # Empêche le clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Empêche le sniffing de type MIME
  Header always set X-Content-Type-Options "nosniff"
  # Force HTTPS si disponible
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Politique de référent (ne pas envoyer l'URL aux sites externes)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Désactive les fonctionnalités navigateur non utilisées
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ===== REDIRECTION www → sans www (optionnel) =====
# Décommenter si ton domaine principal est sans www
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
